# Copy to `.env` and adjust. The backend reads these on startup.

# The Bedrock model id (or inference profile id) you have access to.
# Current Anthropic models require a cross-region inference profile, prefixed
# by your region's geo: us.* / eu.* / apac.* (us-west-2 -> us.).
MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Region where you have Bedrock model access enabled.
AWS_REGION=us-west-2

# Bedrock Knowledge Base id (set after provisioning the KB; see backend/infra/).
# Used by the Stage-3 search_products (RAG) tool. Leave blank until provisioned.
KNOWLEDGE_BASE_ID=
